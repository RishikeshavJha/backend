rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public Civic Registry Collection (CivicLens AI)
    // Allows public reading of civic issues and citizen reporting
    match /public/{docId} {
      allow read: if true;
      allow create: if true; // allows citizen issue reporting (authenticated or guest)
      allow update, delete: if request.auth != null;
    }

    // Existing collections from your project
    match /adminAuditLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /teacherActivity/{docId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
